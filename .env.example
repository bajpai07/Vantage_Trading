# Application environment (no migration credentials here, ever). `pnpm setup:env` creates .env from this file.
APP_ENV=local
LOG_LEVEL=info
DATABASE_URL=postgres://vantage_app:change-me@127.0.0.1:55432/vantage_dev
MARKET_DATA_SOURCE=FIXTURE

# API (M2). WEB_ORIGIN is the single origin allowed by CORS and the CSRF check.
PORT=3000
WEB_ORIGIN=http://localhost:3000
SESSION_IDLE_MINUTES=480
SESSION_ABSOLUTE_DAYS=7
# false is allowed only when APP_ENV is local or test
COOKIE_SECURE=false
