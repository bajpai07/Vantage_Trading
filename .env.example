# Application environment (no migration credentials here, ever). `pnpm setup:env` creates .env from this file.
APP_ENV=local
LOG_LEVEL=info
DATABASE_URL=postgres://vantage_app:change-me@127.0.0.1:55432/vantage_dev
MARKET_DATA_SOURCE=FIXTURE
# M7a: simulated market data (D-74 to D-78). MARKET_DATA_SOURCE=SIM serves simulated stocks and ETFs; CRYPTO_FEED=sim adds
# simulated crypto (needs SIM). All SIM prices are labelled SIM and are not real. FIXTURE is for local development and tests.
# In staging or production SIM requires DEMO_MODE=true; FIXTURE is never allowed there.
CRYPTO_FEED=off
# NYSE (the real exchange calendar) or ALWAYS_OPEN (simulated stocks open around the clock; only valid with SIM)
SIM_SESSION=NYSE
DEMO_MODE=false
# the simulated prices are a pure function of this seed and the time
SIM_SEED=vantage-demo-1
SIM_TICK_MS=1000
# candle requests per user per minute, in cost points (a maximum daily request costs 8; M7b)
CANDLES_RATE_LIMIT_PER_MINUTE=120

# API (M2). WEB_ORIGIN is the single origin allowed by CORS and the CSRF check.
# The API listens on 4000 so the web app (apps/web) can use 3000. WEB_ORIGIN is the WEB app's origin: the browser reaches
# the API only through the web app's same-origin proxy (D-65), so that is the Origin the API sees.
PORT=4000
WEB_ORIGIN=http://localhost:3000
SESSION_IDLE_MINUTES=480
SESSION_ABSOLUTE_DAYS=7
# false is allowed only when APP_ENV is local or test
COOKIE_SECURE=false

# Trading (M4b). TRADING_ENABLED is the kill switch: it defaults to true for local/test, and staging/production must set it
# explicitly. ORDER_RATE_LIMIT_PER_MINUTE limits POST /v1/orders per user (in memory, per process).
TRADING_ENABLED=true
ORDER_RATE_LIMIT_PER_MINUTE=30

# D-69: the reverse proxies / web servers whose X-Forwarded-For header may be believed (comma-separated IPs or CIDRs).
# Empty (the default) trusts nobody: the client address is the socket address. When the web app (apps/web) calls this API
# through its proxy, list the web server here (and any proxy in front of it), for example 127.0.0.1/32,::1/128 on one machine.
# REQUIRED in staging and production ("none" trusts nobody).
TRUSTED_PROXY_CIDRS=
