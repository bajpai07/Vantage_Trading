# Application environment (no migration credentials here, ever). `pnpm setup:env` creates .env from this file.
APP_ENV=local
LOG_LEVEL=info
DATABASE_URL=postgres://vantage_app:change-me@127.0.0.1:55432/vantage_dev
MARKET_DATA_SOURCE=FIXTURE

# API (M2). WEB_ORIGIN is the single origin allowed by CORS and the CSRF check.
# The API listens on 4000 so the web app (apps/web) can use 3000. WEB_ORIGIN is the WEB app's origin: the browser reaches
# the API only through the web app's same-origin proxy (D-65), so that is the Origin the API sees.
PORT=4000
WEB_ORIGIN=http://localhost:3000
SESSION_IDLE_MINUTES=480
SESSION_ABSOLUTE_DAYS=7
# false is allowed only when APP_ENV is local or test
COOKIE_SECURE=false

# Trading (M4b). TRADING_ENABLED is the kill switch: it defaults to true for local/test, and staging/production must set it
# explicitly. ORDER_RATE_LIMIT_PER_MINUTE limits POST /v1/orders per user (in memory, per process).
TRADING_ENABLED=true
ORDER_RATE_LIMIT_PER_MINUTE=30
