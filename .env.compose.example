# VANTAGE compose stack (M10, D-110). PLACEHOLDERS ONLY: never put a real secret in this file.
# `pnpm compose:setup` copies it to the untracked .env.compose with strong random passwords (they are never printed).
POSTGRES_SUPERUSER_PASSWORD=change-me
VANTAGE_MIGRATOR_PASSWORD=change-me
VANTAGE_APP_PASSWORD=change-me

# Host port of the web app (the only published port; Postgres and the API are NOT published). Pick one outside the Windows excluded
# ranges: netsh interface ipv4 show excludedportrange protocol=tcp
WEB_PORT=3000

# The simulated market: stocks, ETFs and crypto, open around the clock, so the demo works at any hour
SIM_SEED=vantage-demo-1
SIM_SESSION=ALWAYS_OPEN
CRYPTO_FEED=sim
MATCHER=on

# The "Try the demo" button (D-113). Off in .env.example, on here.
DEMO_ACCOUNTS=on

# The compose network: the web container is the one trusted proxy of the API (D-69). Docker's default ranges.
TRUSTED_PROXY_CIDRS=172.16.0.0/12,10.0.0.0/8,192.168.0.0/16
