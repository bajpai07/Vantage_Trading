# Web app environment (no secrets here, ever). Copy to .env.local for local development.
# The API this app talks to. The browser never calls it directly: Next proxies /api/* to it (same origin, D-65).
# Optional in local and test (default http://127.0.0.1:4000); REQUIRED when APP_ENV is staging or production.
# NOTE: it is read when the app is built or started (the proxy rewrite is computed from it).
API_BASE_URL=http://127.0.0.1:4000
# local | test | staging | production (default local)
APP_ENV=local
# How often the portfolio refreshes while the tab is visible, in milliseconds (1000 to 300000, default 15000).
PORTFOLIO_POLL_MS=15000
