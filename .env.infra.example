# Infrastructure / migration environment. `pnpm setup:env` creates .env.infra from this file with random secrets.
# Never give this file to an application process.

# Host port for Postgres, bound to 127.0.0.1 only. The default is 55432;
# change it with `pnpm setup:env --port <n>` if that port is busy on your machine.
POSTGRES_HOST_PORT=55432

POSTGRES_SUPERUSER_PASSWORD=change-me
VANTAGE_MIGRATOR_PASSWORD=change-me
VANTAGE_APP_PASSWORD=change-me

DATABASE_MIGRATOR_URL=postgres://vantage_migrator:change-me@127.0.0.1:55432/vantage_dev
