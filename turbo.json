{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "*.tsbuildinfo", ".next/**", "!.next/cache/**"],
      "env": ["API_BASE_URL", "APP_ENV", "PORTFOLIO_POLL_MS", "TRUST_FORWARDED_FOR"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "lint": {}
  }
}
